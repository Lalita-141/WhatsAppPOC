NODE_ENV=development
PORT=5001

# Database. The app connects with these parts; the Prisma CLI builds its URL
# from them too, unless DATABASE_URL is set.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=enterprise_whatsapp

# Secrets. Production requires 32+ random characters each, all different:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_PROFILE_SETUP_SECRET=
# Required in production. Changing it invalidates OTPs currently in flight.
OTP_HASH_SECRET=

# Sessions
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins. The mobile app needs none. Never * in production.
CORS_ORIGINS=
# Number of proxies in front of the app. Rate limits use the real client IP only
# when this is correct. 0 = directly exposed.
TRUST_PROXY=0

# SMS: console (development only, logs the code) or twilio
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Set one of these two
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Development only: returns the OTP in the API response for the test helper in
# the app. The server refuses to start with this set in production.
OTP_DEV_ECHO=false

# Firebase Admin. Use a path outside the repo, or inline JSON. Never commit these.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

LOG_LEVEL=debug

# ---- Media (Phase 7) ----
# Only "local" exists today: files are written under MEDIA_STORAGE_DIR on this
# server. Back this folder up with the database. A cloud bucket provider is not
# implemented yet.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_DIR=storage/media
# Signs the 10-minute download links. Required in production (32+ characters).
MEDIA_URL_SECRET=
